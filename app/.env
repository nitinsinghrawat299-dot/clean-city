# Flask session signing key (any long random string)
SECRET_KEY=

# Municipality admin login (generate the hash with generate_password_hash.py)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Only needed for LOCAL runs — path to a service-account JSON key
# downloaded from Firebase Console > Project Settings > Service Accounts.
# Leave unset on Cloud Run; it uses its own service account automatically.
GOOGLE_APPLICATION_CREDENTIALS=

# Cloudinary — free image hosting (no card needed). From your Cloudinary
# dashboard after signup: Dashboard > "API Environment variable" — copy
# the whole CLOUDINARY_URL=cloudinary://... value shown there.
CLOUDINARY_URL=

# Optional — garbage-detection check via Roboflow
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=garbage_detection-wvzwv/9

# Email — used for "forgot password" reset links.
# Gmail: use an App Password (not your normal Gmail password), see
# https://myaccount.google.com/apppasswords
#   SMTP_SERVER=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=youraddress@gmail.com
#   SMTP_PASSWORD=<16-character app password>
#   EMAIL_FROM=youraddress@gmail.com
#
# SendGrid: use their SMTP relay instead
#   SMTP_SERVER=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USERNAME=apikey
#   SMTP_PASSWORD=<your SendGrid API key>
#   EMAIL_FROM=<a verified sender address in SendGrid>
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
